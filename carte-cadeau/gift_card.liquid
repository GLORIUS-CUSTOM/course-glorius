{% layout none %}
{%- comment -%}
  Page de la carte-cadeau GLORIUS.
  À coller dans : Boutique en ligne > Thèmes > (thème publié) > Modifier le code > templates/gift_card.liquid
  Images hébergées sur glorius-custom.github.io/course-glorius/carte-cadeau/
{%- endcomment -%}
{%- assign img = 'https://glorius-custom.github.io/course-glorius/carte-cadeau/' -%}
{%- assign formatted_balance = gift_card.balance | money_without_trailing_zeros | strip_html -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0b0b0c">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>Carte-cadeau {{ shop.name }} · {{ formatted_balance }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Jost:wght@300;400;500&display=swap">

    <script type="importmap">
      {
        "imports": {
          "@theme/component": "{{ 'component.js' | asset_url }}",
          "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
          "@theme/qr-code-generator": "{{ 'qr-code-generator.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'qr-code-image.js' | asset_url }}" type="module" fetchpriority="low"></script>
    <script src="{{ 'copy-to-clipboard.js' | asset_url }}" type="module" fetchpriority="low"></script>

    {{ content_for_header }}

    <style>
      :root {
        --ink: #0b0b0c; --chalk: #f1efe9; --mist: #a19e96; --hair: rgba(241,239,233,.16);
        --gold: #e8c27a;
        --f-display: 'Bodoni Moda', 'Didot', 'Bodoni 72', Georgia, serif;
        --f-body: 'Jost', 'Futura', 'Century Gothic', system-ui, sans-serif;
        --card-w: min(86vw, 440px);
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--ink); }
      body { color: var(--chalk); font: 300 16px/1.6 var(--f-body); min-height: 100vh; overflow-x: hidden; }
      .gc-bg { position: fixed; inset: 0; z-index: 0;
        background: linear-gradient(180deg, rgba(11,11,12,.45), rgba(11,11,12,.88) 55%, var(--ink)),
                    url({{ img }}tissus.jpg) center top / cover no-repeat; }
      .gc { position: relative; z-index: 1; max-width: 560px; margin: 0 auto; text-align: center;
        padding: max(40px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) 64px max(20px, env(safe-area-inset-left)); }
      .gc-logo { width: 132px; height: auto; display: block; margin: 0 auto 8px; }
      .gc-eyebrow { font: 500 11px/1.4 var(--f-body); letter-spacing: .32em; text-transform: uppercase; color: var(--mist); margin: 0; }
      .gc-for { font: italic 400 clamp(26px, 6vw, 34px)/1.2 var(--f-display); margin: 6px 0 0; text-wrap: balance; }

      /* ---------- carte ---------- */
      .gc-stage { position: relative; width: var(--card-w); aspect-ratio: 856 / 540; margin: 40px auto 44px; }
      .gc-card { position: absolute; inset: 0; border-radius: 4.5% / 7%; overflow: hidden;
        box-shadow: 0 24px 40px rgba(0,0,0,.6), 0 2px 4px rgba(0,0,0,.5); }
      .gc-card img { width: 100%; height: 100%; display: block; }

      /* ---------- détails ---------- */
      .gc-amount { font: 400 clamp(56px, 16vw, 84px)/1 var(--f-display); margin: 0; font-variant-numeric: lining-nums; }
      .gc-sub { color: var(--mist); font-size: 14px; margin: 10px 0 0; }
      .gc-badge { display: inline-block; margin-top: 14px; padding: 4px 12px; border: 1px solid var(--hair); font: 500 11px/1.6 var(--f-body); letter-spacing: .2em; text-transform: uppercase; color: var(--mist); }
      .gc-msg { margin: 36px auto 0; max-width: 34ch; font: italic 400 21px/1.5 var(--f-display); color: var(--chalk); }
      .gc-msg cite { display: block; margin-top: 10px; font: 500 11px/1.4 var(--f-body); font-style: normal; letter-spacing: .26em; text-transform: uppercase; color: var(--mist); }
      .gc-codebox { margin: 44px auto 0; padding-top: 30px; border-top: 1px solid var(--hair); display: grid; gap: 18px; justify-items: center; }
      .gc-code { font: 400 clamp(20px, 5.6vw, 26px)/1.2 var(--f-body); letter-spacing: .14em; margin: 0; word-break: break-word; }
      .gc-qr { background: #fff; padding: 10px; border-radius: 6px; line-height: 0; }
      .gc-qr img, .gc-qr canvas { display: block; }
      .gc-actions { display: grid; gap: 10px; width: min(100%, 300px); margin: 6px auto 0; }
      .gc-btn { display: block; width: 100%; padding: 14px 18px; border: 0; cursor: pointer; text-decoration: none; text-align: center;
        font: 500 12px/1 var(--f-body); letter-spacing: .22em; text-transform: uppercase; background: var(--chalk); color: var(--ink); }
      .gc-btn:hover { background: var(--gold); }
      .gc-btn--ghost { background: transparent; color: var(--chalk); border: 1px solid var(--hair); }
      .gc-btn--ghost:hover { background: transparent; border-color: var(--chalk); }
      .gc-wallet { display: block; margin: 0 auto; }
      copy-to-clipboard-component { position: relative; display: block; }
      .form__message { position: absolute; left: 0; right: 0; top: -26px; font-size: 13px; color: var(--gold); transition: opacity .3s; }
      .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; opacity: 0; }
      .gc-foot { margin: 48px 0 0; font-size: 13px; color: var(--mist); }
      :focus-visible { outline: 1px solid var(--gold); outline-offset: 3px; }
    </style>
  </head>

  <body>
    <div class="gc-bg" aria-hidden="true"></div>
    <main class="gc">
      <img class="gc-logo" src="{{ img }}logo-glorius.svg" alt="{{ shop.name }}" width="132" height="51">
      <p class="gc-eyebrow">Carte-cadeau</p>
      {%- assign destinataire = gift_card.recipient.nickname | default: gift_card.recipient.name -%}
      {%- if destinataire != blank -%}
        <p class="gc-for">Pour {{ destinataire | escape }}</p>
      {%- else -%}
        <p class="gc-for">Un cadeau fait sur mesure</p>
      {%- endif -%}

      <div class="gc-stage" aria-hidden="true">
        <div class="gc-card"><img src="{{ img }}carte.png" alt="" width="856" height="540"></div>
      </div>

      <section >
        <p class="gc-amount">{{ formatted_balance }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="gc-sub">Solde restant sur une carte de {{ gift_card.initial_value | money_without_trailing_zeros }}</p>
        {%- endif -%}
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <span class="gc-badge">Expirée</span>
        {%- elsif gift_card.expires_on -%}
          <p class="gc-sub">Valable jusqu'au {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
        {%- endif -%}
      </section>

      {%- if gift_card.message != blank -%}
        <blockquote class="gc-msg">
          «&nbsp;{{ gift_card.message | escape | newline_to_br }}&nbsp;»
          {%- if gift_card.recipient and gift_card.customer.first_name != blank -%}<cite>{{ gift_card.customer.first_name | escape }}</cite>{%- endif -%}
        </blockquote>
      {%- endif -%}

      <section class="gc-codebox">
        <p class="gc-eyebrow">Votre code</p>
        <p class="gc-code">{{ gift_card.code | format_code }}</p>
        <div class="gc-qr">
          <qr-code-image data-identifier="{{ gift_card.qr_identifier }}" width="112" height="112" alt="Code QR de la carte-cadeau"></qr-code-image>
        </div>
        <p class="gc-sub">Présentez ce code QR en boutique, ou entrez le code au paiement en ligne.</p>
        <div class="gc-actions">
          <copy-to-clipboard-component text-to-copy="{{ gift_card.code }}">
            <span class="form__message visually-hidden" ref="copySuccessMessage" role="status">Code copié</span>
            <button class="gc-btn" type="button" on:click="/copyToClipboard">Copier le code</button>
          </copy-to-clipboard-component>
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="gc-wallet">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="140" height="44" alt="Ajouter à Apple Wallet" loading="lazy">
            </a>
          {%- endif -%}
          <a href="{{ shop.url }}" class="gc-btn gc-btn--ghost" target="_blank" rel="noopener">Visiter la boutique</a>
        </div>
      </section>

      <p class="gc-foot">Valable dans nos boutiques {{ shop.name }} et en ligne.</p>
    </main>
  </body>
</html>
